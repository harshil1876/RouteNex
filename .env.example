# RouteNex — Environment Variables

# ─── Supabase Authentication (Cloud Edition) ───────────────────────────
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Gateway Configuration ────────────────────────────────────────────
# Port for the RouteNex gateway API server
ROUTENEX_PORT=3001

# Host to bind to (use 0.0.0.0 for Docker/external access)
ROUTENEX_HOST=127.0.0.1

# ─── Authentication (Optional) ───────────────────────────────────────
# Set this to require Bearer token auth on all API endpoints.
# Leave empty/unset for localhost development (no auth required).
# ROUTENEX_API_KEY=sk-routenex-your-secret-key-here

# ─── Mock Mode ────────────────────────────────────────────────────────
# Enable mock provider for zero-cost local testing.
# When true, the 'auto' strategy will include mock models.
ROUTENEX_MOCK_MODE=true

# ─── Provider API Keys (BYOK) ────────────────────────────────────────
# Uncomment and set the keys for providers you want to use.
# Each provider is automatically enabled when its key is set.

# Groq — https://console.groq.com/keys (free tier available)
# GROQ_API_KEY=gsk_your_groq_key_here

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_openai_key_here

# ─── Routing Configuration ───────────────────────────────────────────
# Default routing strategy: explicit | cost | latency | balanced
ROUTENEX_DEFAULT_STRATEGY=balanced

# Maximum retry attempts on retriable errors (429, 5xx, timeout)
ROUTENEX_MAX_RETRIES=2

# Request timeout in milliseconds
ROUTENEX_TIMEOUT_MS=60000

# ─── Persistence ──────────────────────────────────────────────────────
# Enable request metadata logging (latency, tokens, cost estimates)
ROUTENEX_PERSISTENCE=true

# Path to the JSON log file
ROUTENEX_DB_PATH=./data/requests.json

# Log prompt contents (SECURITY WARNING: disabled by default)
ROUTENEX_LOG_PROMPTS=false

# ─── Rate Limiting ───────────────────────────────────────────────────
# Requests per minute per client IP
ROUTENEX_RATE_LIMIT_RPM=60
