---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Pricing — RouteNex Open Source vs Cloud Edition">
  <Header />

  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-hairline text-ink text-xs font-mono">
        <span>Transparent Dual-Edition Architecture</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink font-sans">
        Zero Markup. 100% BYOK.
      </h1>
      <p class="text-body text-base">
        RouteNex Open Source is free forever, self-hosted on your own hardware with no cloud dependency. RouteNex Cloud adds managed team RBAC, shared billing, and edge routing.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {/* 1. Open Source */}
      <div class="p-8 rounded-2xl border-2 border-hairline bg-elevated space-y-6 flex flex-col justify-between shadow-sm">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-mute">Open Source</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-mono font-bold">
              MIT License
            </span>
          </div>

          <div>
            <div class="text-4xl font-bold text-ink font-mono">$0</div>
            <div class="text-xs text-mute mt-1">Free forever · 100% Offline Standalone</div>
          </div>

          <ul class="space-y-2.5 text-xs text-body font-mono">
            <li class="flex items-center gap-2 text-ink">✓ Unlimited local requests</li>
            <li class="flex items-center gap-2 text-ink">✓ All 19 routing strategies</li>
            <li class="flex items-center gap-2 text-ink">✓ 12-engine LexiPack compression</li>
            <li class="flex items-center gap-2 text-ink">✓ Built-in MCP stdio & HTTP server</li>
            <li class="flex items-center gap-2 text-ink">✓ Zero cloud account required</li>
            <li class="flex items-center gap-2 text-ink">✓ SQLite storage & maintenance</li>
          </ul>
        </div>

        <div class="space-y-2">
          <a
            href="/docs/getting-started/quick-start"
            class="block w-full py-3 rounded-xl bg-sky-500 hover:bg-sky-400 !text-zinc-950 font-semibold text-xs text-center font-sans transition-transform hover:scale-[1.02] shadow-xs"
          >
            Get Started — Open Source (npx routenex) →
          </a>
          <a
            href="/dashboard"
            class="block w-full py-2.5 rounded-xl border border-hairline bg-canvas hover:bg-elevated text-body text-[11px] text-center font-sans transition"
          >
            Open Local Gateway (:3001) →
          </a>
        </div>
      </div>

      {/* 2. Cloud Developer (Pro) */}
      <div id="waitlist" class="p-8 rounded-2xl border-2 border-sky-500/50 bg-[#111113] text-white space-y-6 flex flex-col justify-between shadow-xl relative overflow-hidden">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-xs font-sans font-bold uppercase tracking-wider text-sky-400">RouteNex Cloud</span>
            <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-400 font-sans font-semibold">
              Private Beta Waitlist
            </span>
          </div>

          <div>
            <div class="text-4xl font-bold text-white font-sans">$20 <span class="text-xs font-normal text-zinc-400">/ month (post-beta)</span></div>
            <div class="text-xs text-zinc-400 mt-1">Managed Global Edge Gateway & Team Keystores</div>
          </div>

          <ul class="space-y-2.5 text-xs text-zinc-300 font-sans">
            <li class="flex items-center gap-2 text-white">✓ Everything in Open Source</li>
            <li class="flex items-center gap-2 text-white">✓ Managed Edge Endpoints with 99.99% uptime</li>
            <li class="flex items-center gap-2 text-white">✓ Multi-tenant Team Workspace & RBAC</li>
            <li class="flex items-center gap-2 text-white">✓ Centralized Multi-Key Pooling & Spend Caps</li>
            <li class="flex items-center gap-2 text-white">✓ Real-time Audit Logging & Team Analytics</li>
            <li class="flex items-center gap-2 text-white">✓ Zero server setup or maintenance</li>
          </ul>
        </div>

        <button
          type="button"
          data-waitlist-trigger
          class="w-full py-3 rounded-xl bg-sky-500 hover:bg-sky-400 !text-zinc-950 font-semibold text-xs text-center font-sans shadow-md transition-transform hover:scale-[1.02] cursor-pointer"
        >
          Join RouteNex Cloud Waitlist →
        </button>
      </div>

      {/* 3. Enterprise */}
      <div class="p-8 rounded-2xl border-2 border-hairline bg-elevated space-y-6 flex flex-col justify-between shadow-sm">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-xs font-sans font-bold uppercase tracking-wider text-mute">Enterprise</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-canvas border border-hairline text-body font-sans font-medium">
              VPC / Air-Gapped
            </span>
          </div>

          <div>
            <div class="text-4xl font-bold text-ink font-sans">Custom</div>
            <div class="text-xs text-mute mt-1">Dedicated VPC / Air-Gapped / Custom SLAs</div>
          </div>

          <ul class="space-y-2.5 text-xs text-body font-sans">
            <li class="flex items-center gap-2 text-ink">✓ Everything in Cloud Pro</li>
            <li class="flex items-center gap-2 text-ink">✓ SSO / SAML & SCIM provisioning</li>
            <li class="flex items-center gap-2 text-ink">✓ Dedicated hardware isolation</li>
            <li class="flex items-center gap-2 text-ink">✓ Custom compliance (SOC2, HIPAA)</li>
            <li class="flex items-center gap-2 text-ink">✓ Dedicated Slack engineering channel</li>
          </ul>
        </div>

        <button
          type="button"
          data-waitlist-trigger
          class="w-full py-3 rounded-xl border border-hairline bg-canvas hover:bg-elevated text-ink font-medium text-xs text-center font-sans transition-transform hover:scale-[1.02] cursor-pointer"
        >
          Request Enterprise Consultation →
        </button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
