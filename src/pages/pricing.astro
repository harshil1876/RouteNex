---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Pricing — RouteNex Open Source vs Cloud Edition">
  <Header />

  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-12">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-600 dark:text-purple-400 text-xs font-mono">
        <span>Transparent Dual-Edition Architecture</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink font-sans">
        Zero Markup. 100% BYOK.
      </h1>
      <p class="text-body text-base">
        RouteNex Open Source is free forever, self-hosted on your own hardware with no cloud dependency. RouteNex Cloud adds managed team RBAC, shared billing, and edge routing.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {/* 1. Open Source */}
      <div class="p-8 rounded-2xl border-2 border-hairline bg-elevated space-y-6 flex flex-col justify-between shadow-sm">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-mute">Open Source</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-mono font-bold">
              MIT License
            </span>
          </div>

          <div>
            <div class="text-4xl font-bold text-ink font-mono">$0</div>
            <div class="text-xs text-mute mt-1">Free forever · 100% Offline Standalone</div>
          </div>

          <ul class="space-y-2.5 text-xs text-body font-mono">
            <li class="flex items-center gap-2 text-ink">✓ Unlimited local requests</li>
            <li class="flex items-center gap-2 text-ink">✓ All 19 routing strategies</li>
            <li class="flex items-center gap-2 text-ink">✓ 12-engine Caveman compression</li>
            <li class="flex items-center gap-2 text-ink">✓ Built-in MCP stdio & HTTP server</li>
            <li class="flex items-center gap-2 text-ink">✓ Zero cloud account required</li>
            <li class="flex items-center gap-2 text-ink">✓ SQLite storage & maintenance</li>
          </ul>
        </div>

        <a
          href="/dashboard"
          class="w-full py-3 rounded-xl bg-ink text-white dark:bg-white dark:text-black font-medium text-xs text-center font-mono transition-transform hover:scale-[1.02]"
        >
          Launch Local Dashboard →
        </a>
      </div>

      {/* 2. Cloud Developer (Pro) */}
      <div class="p-8 rounded-2xl border-2 border-purple-500 bg-[#121520] text-white space-y-6 flex flex-col justify-between shadow-xl relative overflow-hidden">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-purple-300">Cloud Pro</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 font-mono font-bold">
              Popular
            </span>
          </div>

          <div>
            <div class="text-4xl font-bold text-white font-mono">$20 <span class="text-xs font-normal text-[#8e97ae]">/ month</span></div>
            <div class="text-xs text-[#8e97ae] mt-1">Managed Cloud Edge Gateway</div>
          </div>

          <ul class="space-y-2.5 text-xs text-[#c0c7d8] font-mono">
            <li class="flex items-center gap-2 text-white">✓ Everything in Open Source</li>
            <li class="flex items-center gap-2 text-white">✓ Edge Worker global deployment (D1)</li>
            <li class="flex items-center gap-2 text-white">✓ Team RBAC & Supabase Auth</li>
            <li class="flex items-center gap-2 text-white">✓ Centralized multi-key pooling</li>
            <li class="flex items-center gap-2 text-white">✓ Cloud Audit logging & Slack alerts</li>
            <li class="flex items-center gap-2 text-white">✓ 99.99% edge uptime SLA</li>
          </ul>
        </div>

        <a
          href="/signup"
          class="w-full py-3 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-medium text-xs text-center font-mono shadow-lg shadow-purple-600/30 transition-transform hover:scale-[1.02]"
        >
          Start 14-Day Cloud Trial →
        </a>
      </div>

      {/* 3. Enterprise */}
      <div class="p-8 rounded-2xl border-2 border-hairline bg-elevated space-y-6 flex flex-col justify-between shadow-sm">
        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-mute">Enterprise</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-canvas border border-hairline text-body font-mono">
              Custom
            </span>
          </div>

          <div>
            <div class="text-4xl font-bold text-ink font-mono">Custom</div>
            <div class="text-xs text-mute mt-1">Dedicated VPC / Air-Gapped / Custom SLAs</div>
          </div>

          <ul class="space-y-2.5 text-xs text-body font-mono">
            <li class="flex items-center gap-2 text-ink">✓ Everything in Cloud Pro</li>
            <li class="flex items-center gap-2 text-ink">✓ SSO / SAML & SCIM provisioning</li>
            <li class="flex items-center gap-2 text-ink">✓ Dedicated hardware isolation</li>
            <li class="flex items-center gap-2 text-ink">✓ Custom compliance (SOC2, HIPAA)</li>
            <li class="flex items-center gap-2 text-ink">✓ Dedicated Slack engineering channel</li>
          </ul>
        </div>

        <a
          href="https://github.com/harshil1876/RouteNex/issues"
          target="_blank"
          class="w-full py-3 rounded-xl border border-hairline bg-canvas hover:bg-elevated text-ink font-medium text-xs text-center font-mono transition-transform hover:scale-[1.02]"
        >
          Contact Enterprise Team →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
