---
import Layout from '../../layouts/Layout.astro';
import DashboardOverview from '../../components/dashboard/DashboardOverview';
import ThemeToggle from '../../components/ThemeToggle.astro';
---

<Layout title="Console — RouteNex Telemetry & Observability">
  <div class="min-h-screen bg-canvas flex flex-col md:flex-row">
    <!-- Dashboard Sidebar -->
    <aside class="w-full md:w-64 border-b md:border-b-0 md:border-r border-hairline bg-elevated/60 backdrop-blur-md p-4 flex flex-col justify-between shrink-0">
      <div class="space-y-6">
        <!-- Brand Header -->
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-2.5 text-ink font-semibold tracking-tight transition hover:opacity-90">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-ink text-white dark:bg-white dark:text-black">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2L2 12l10 10 10-10L12 2z"></path>
                <circle cx="12" cy="12" r="2.5" fill="currentColor"></circle>
              </svg>
            </span>
            <span class="text-base font-semibold tracking-tight text-ink">RouteNex</span>
          </a>
          <span class="rounded bg-canvas px-2 py-0.5 font-mono text-[10px] text-mute border border-hairline">
            Console
          </span>
        </div>

        <!-- Sidebar Navigation -->
        <nav class="space-y-1 font-mono text-xs" aria-label="Dashboard Navigation">
          <a
            href="/dashboard"
            class="flex items-center gap-2.5 rounded-md bg-ink px-3 py-2 text-white dark:bg-white dark:text-black font-medium"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Console
          </a>

          <a
            href="/#editions"
            class="flex items-center gap-2.5 rounded-md px-3 py-2 text-body hover:bg-hairline hover:text-ink transition"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            Product Editions
          </a>

          <a
            href="/docs"
            class="flex items-center gap-2.5 rounded-md px-3 py-2 text-body hover:bg-hairline hover:text-ink transition"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            Docs & SDKs
          </a>
        </nav>
      </div>

      <!-- Footer Info in Sidebar -->
      <div class="mt-6 md:mt-0 pt-4 border-t border-hairline space-y-2">
        <a
          href="/docs"
          class="flex items-center justify-between text-xs font-mono text-mute hover:text-ink transition"
        >
          <span>Documentation</span>
          <span>↗</span>
        </a>
        <a
          href="/"
          class="flex items-center justify-between text-xs font-mono text-mute hover:text-ink transition"
        >
          <span>Landing Page</span>
          <span>←</span>
        </a>
        <div class="pt-2 text-[11px] font-mono text-mute">
          RouteNex Gateway v0.1.0
        </div>
      </div>
    </aside>

    <!-- Main Dashboard Area -->
    <main id="main-content" class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <!-- Top Bar -->
      <header class="h-16 border-b border-hairline bg-elevated/80 backdrop-blur-md px-4 sm:px-8 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
          <h1 class="text-base sm:text-lg font-semibold text-ink tracking-tight">RouteNex Console</h1>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-mono text-emerald-600 dark:text-emerald-400">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            port 3001
          </span>
        </div>

        <div class="flex items-center gap-3">
          <ThemeToggle />

          <a
            href="/docs"
            class="text-xs font-mono text-body hover:text-ink transition hidden sm:inline-block"
          >
            API Reference
          </a>
          <a
            href="https://github.com/harshil1876/RouteNex"
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-elevated px-3 py-1 text-xs font-mono text-ink hover:bg-hairline transition"
          >
            <span>GitHub</span>
          </a>
        </div>
      </header>

      <!-- Dashboard Interactive Island -->
      <div class="p-4 sm:p-6 lg:p-8 max-w-7xl w-full">
        <DashboardOverview client:load />
      </div>
    </main>
  </div>
</Layout>
