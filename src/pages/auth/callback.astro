---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Authenticating — RouteNex Cloud">
  <div class="min-h-screen bg-[#0b0d13] text-[#e0e2ec] flex flex-col justify-center items-center px-4 relative overflow-hidden">
    <div class="w-full max-w-sm text-center relative z-10">
      <div class="w-12 h-12 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center mx-auto mb-4 animate-pulse">
        <span class="text-2xl">⚡</span>
      </div>
      <h2 class="text-lg font-semibold text-white tracking-tight">Authenticating Session...</h2>
      <p class="text-xs text-[#8f96a3] mt-2 font-mono" id="callback-status">Exchanging cryptographic tokens with Supabase...</p>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  async function handleCallback() {
    const statusEl = document.getElementById('callback-status');
    try {
      const { data, error } = await supabase.auth.getSession();
      if (error) {
        if (statusEl) statusEl.textContent = `Authentication error: ${error.message}`;
        setTimeout(() => {
          window.location.href = '/login';
        }, 2000);
        return;
      }

      if (data.session) {
        if (statusEl) statusEl.textContent = 'Session verified! Redirecting to dashboard...';
        setTimeout(() => {
          window.location.href = '/dashboard';
        }, 500);
      } else {
        // Fallback redirect
        window.location.href = '/dashboard';
      }
    } catch {
      window.location.href = '/dashboard';
    }
  }

  handleCallback();
</script>
