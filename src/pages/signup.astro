---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign Up — RouteNex Cloud">
  <div class="min-h-screen bg-[#09090b] text-zinc-200 flex flex-col justify-center items-center px-4 relative overflow-hidden">
    <!-- Subtle technical grid background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#27272a15_1px,transparent_1px),linear-gradient(to_bottom,#27272a15_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10">
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2.5 mb-3 group" aria-label="RouteNex Home">
          <img src="/logo.png" alt="RouteNex" width="36" height="36" class="h-9 w-9 rounded-xl object-contain shadow-sm" />
          <span class="text-xl font-bold tracking-tight text-white font-sans">RouteNex <span class="text-zinc-400 font-normal">Cloud</span></span>
        </a>
        <h1 class="text-xl font-semibold text-white tracking-tight font-sans">Create Your Cloud Account</h1>
        <p class="text-xs text-zinc-400 mt-1 font-sans">Start with 100K Free Gateway Requests • No Credit Card</p>
      </div>

      <div class="bg-[#111113] border border-[#222226] rounded-xl p-6 shadow-2xl backdrop-blur-md">
        <!-- OAuth Buttons -->
        <div class="grid grid-cols-2 gap-3 mb-5">
          <button id="btn-github" type="button" class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-[#18181b] hover:bg-[#27272a] border border-[#27272a] text-xs font-medium text-white transition-all shadow-sm">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </button>
          <button id="btn-google" type="button" class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-[#18181b] hover:bg-[#27272a] border border-[#27272a] text-xs font-medium text-white transition-all shadow-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.7 0 3 .7 3.9 1.5l2.9-2.9C17 2 14.7 1.2 12 1.2 7.7 1.2 4.1 3.7 2.4 7.2l3.4 2.6C6.6 7.2 9 5 12 5z"/><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/><path fill="#FBBC05" d="M5.8 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.2-1.6.4-2.3L2.4 7.6C1.4 9.5.8 11.7.8 14s.6 4.5 1.6 6.4l3.4-2.6v-3z"/><path fill="#34A853" d="M12 22.8c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.4-2.2-6.2-5l-3.4 2.6c1.7 3.5 5.3 6.1 9.6 6.1z"/></svg>
            Google
          </button>
        </div>

        <div class="relative flex items-center justify-center mb-5">
          <div class="border-t border-[#222226] w-full"></div>
          <span class="bg-[#111113] px-2 text-[11px] font-sans uppercase tracking-wider text-zinc-500 absolute">or sign up with email</span>
        </div>

        <form id="form-signup" class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-zinc-400 mb-1 font-sans">Work Email</label>
            <input type="email" id="signup-email" required placeholder="developer@company.com" class="w-full bg-[#18181b] border border-[#27272a] rounded-lg px-3 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-sky-500 font-sans transition-colors" />
          </div>

          <div>
            <label class="block text-xs font-medium text-zinc-400 mb-1 font-sans">Full Name</label>
            <input type="text" id="signup-name" required placeholder="Alex Rivera" class="w-full bg-[#18181b] border border-[#27272a] rounded-lg px-3 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-sky-500 font-sans transition-colors" />
          </div>

          <div>
            <label class="block text-xs font-medium text-zinc-400 mb-1 font-sans">Password (min 8 characters)</label>
            <input type="password" id="signup-password" minlength="8" required placeholder="••••••••••••" class="w-full bg-[#18181b] border border-[#27272a] rounded-lg px-3 py-2 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-sky-500 font-sans transition-colors" />
          </div>

          <div id="signup-error" class="hidden p-2 rounded bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-sans"></div>
          <div id="signup-success" class="hidden p-2.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-sans"></div>

          <button type="submit" class="w-full py-2.5 rounded-lg bg-sky-500 hover:bg-sky-400 !text-zinc-950 font-semibold text-xs shadow-sm transition-all font-sans">
            Create Free Cloud Account →
          </button>
        </form>

        <div class="mt-5 text-center text-xs text-zinc-500">
          Already have an account?
          <a href="/login" class="text-white hover:underline font-medium ml-1">Sign in →</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { signUpWithEmail, signInWithOAuth, isSupabaseConfigured } from '../lib/supabase';

  const formSignup = document.getElementById('form-signup');
  const signupError = document.getElementById('signup-error');
  const signupSuccess = document.getElementById('signup-success');

  formSignup?.addEventListener('submit', async (e) => {
    e.preventDefault();
    signupError?.classList.add('hidden');
    signupSuccess?.classList.add('hidden');

    const email = (document.getElementById('signup-email') as HTMLInputElement).value;
    const name = (document.getElementById('signup-name') as HTMLInputElement).value;
    const password = (document.getElementById('signup-password') as HTMLInputElement).value;

    if (!isSupabaseConfigured()) {
      window.location.href = '/workspace';
      return;
    }

    try {
      const { data, error } = await signUpWithEmail(email, password, { full_name: name });
      if (error) {
        if (signupError) {
          signupError.textContent = error.message;
          signupError.classList.remove('hidden');
        }
      } else {
        if (signupSuccess) {
          signupSuccess.textContent = 'Account created successfully! Redirecting to workspace...';
          signupSuccess.classList.remove('hidden');
        }
        setTimeout(() => {
          window.location.href = '/workspace';
        }, 1200);
      }
    } catch (err: any) {
      if (signupError) {
        signupError.textContent = err.message || 'Signup failed';
        signupError.classList.remove('hidden');
      }
    }
  });

  document.getElementById('btn-github')?.addEventListener('click', () => {
    if (!isSupabaseConfigured()) {
      window.location.href = '/workspace';
      return;
    }
    signInWithOAuth('github');
  });

  document.getElementById('btn-google')?.addEventListener('click', () => {
    if (!isSupabaseConfigured()) {
      window.location.href = '/workspace';
      return;
    }
    signInWithOAuth('google');
  });
</script>
