---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ModelDetailAnalytics from '../../../components/models/ModelDetailAnalytics';
import { UNIFIED_MODELS } from '../../../data/unified-catalog';

export function getStaticPaths() {
  return UNIFIED_MODELS.map((m) => ({
    params: { provider: m.providerSlug, model: m.modelSlug },
    props: {
      displayName: m.displayName,
      contextLength: m.context,
      inputPrice: m.promptPrice,
      outputPrice: m.compPrice,
      speed: m.speed,
      modality: `${m.modality} · ${m.series}${m.reasoning ? ' · Reasoning' : ''}${m.tools ? ' · Tools' : ''}`,
      zdr: m.zdr,
    },
  }));
}

const { provider, model } = Astro.params;
const { displayName, contextLength, inputPrice, outputPrice, speed, modality, zdr } = Astro.props;
---

<Layout title={`${displayName} (${provider}/${model}) Pricing, Latency & Analytics — RouteNex`}>
  <Header />

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-6">
    <ModelDetailAnalytics
      client:load
      provider={provider}
      model={model}
      displayName={displayName}
      contextLength={contextLength}
      inputPrice={inputPrice}
      outputPrice={outputPrice}
      speed={speed}
      modality={modality}
      zdr={zdr}
    />
  </main>

  <Footer />
</Layout>
