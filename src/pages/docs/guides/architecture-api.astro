---
import DocsLayout from '../../../layouts/DocsLayout.astro';
---

<DocsLayout title="Architecture & API Reference" currentPath="/docs/guides/architecture-api">
  <div class="space-y-8 font-mono text-xs">
    <div>
      <div class="text-[11px] text-zinc-400 font-semibold mb-1">SYSTEM ARCHITECTURE</div>
      <h1 class="text-2xl font-bold text-white font-sans">Architecture, Security & API Reference</h1>
      <p class="text-zinc-400 text-sm font-sans mt-1">Hono.js proxy pipeline, circuit breaker lifecycle, and endpoints.</p>
    </div>

    <div class="p-5 rounded-xl bg-[#111113] border border-[#222226] space-y-3">
      <h2 class="text-sm font-bold text-white font-sans">Core Subsystems</h2>
      <div class="space-y-2 text-zinc-400">
        <div>• <strong class="text-white">RouteEngine:</strong> Deterministic candidate evaluator with LKGP, headroom, cache-affinity, and cost sorting.</div>
        <div>• <strong class="text-white">CircuitBreaker:</strong> 3-state state machine (CLOSED, OPEN, HALF_OPEN) with cooldown lockout.</div>
        <div>• <strong class="text-white">PromptCompressor:</strong> Caveman multi-language rules and whitespace compaction saving 30-55% tokens.</div>
        <div>• <strong class="text-white">AdminStore:</strong> AES-256-GCM keystore and SHA-256 virtual key manager.</div>
      </div>
    </div>

    <div class="p-5 rounded-xl bg-[#111113] border border-[#222226] space-y-3">
      <h2 class="text-sm font-bold text-white font-sans">Key API Endpoints</h2>
      <div class="space-y-1 text-xs">
        <div><code class="text-emerald-400">POST /v1/chat/completions</code> — OpenAI-compatible chat proxy</div>
        <div><code class="text-emerald-400">POST /v1/messages</code> — Anthropic Messages API proxy</div>
        <div><code class="text-sky-400">GET  /v1/models</code> — Dynamic model catalog with pricing metadata</div>
        <div><code class="text-emerald-400">POST /v1/router/explain</code> — Dry-run route explainability simulator</div>
        <div><code class="text-emerald-400">POST /v1/mcp</code> — Built-in Model Context Protocol server</div>
        <div><code class="text-sky-400">GET  /health/live</code> — Liveness probe and provider connectivity</div>
      </div>
    </div>
  </div>
</DocsLayout>
