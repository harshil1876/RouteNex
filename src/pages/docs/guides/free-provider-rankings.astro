---
import DocsLayout from '../../../layouts/DocsLayout.astro';
---

<DocsLayout title="Free Provider Rankings" currentPath="/docs/guides/free-provider-rankings">
  <div class="space-y-8 font-mono text-xs">
    <div>
      <div class="text-[11px] text-zinc-400 font-semibold mb-1">FREE TIER LEADERBOARD</div>
      <h1 class="text-2xl font-bold text-white font-sans">Free Provider Rankings (~1.62B Tokens/Mo)</h1>
      <p class="text-zinc-400 text-sm font-sans mt-1">Benchmarked leaderboard of free-tier providers by throughput and reliability.</p>
    </div>

    <div class="p-5 rounded-xl bg-[#111113] border border-[#222226] space-y-4">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-[#222226] text-zinc-400">
            <tr>
              <th class="py-2">Provider</th>
              <th class="py-2">Free Allowance</th>
              <th class="py-2">Speed (tok/s)</th>
              <th class="py-2">Arena ELO</th>
              <th class="py-2">Auth Required</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#222226]">
            <tr>
              <td class="py-2.5 font-bold text-white">Mistral AI</td>
              <td class="py-2.5 text-zinc-200 font-medium">1 Billion / Month</td>
              <td class="py-2.5">140 tps</td>
              <td class="py-2.5 text-emerald-400 font-bold">1,248</td>
              <td class="py-2.5 text-zinc-500">Free API Key</td>
            </tr>
            <tr>
              <td class="py-2.5 font-bold text-white">Cerebras CS-3</td>
              <td class="py-2.5 text-zinc-200 font-medium">1 Million / Day (30M/mo)</td>
              <td class="py-2.5 text-emerald-400 font-bold">2,100 tps</td>
              <td class="py-2.5 text-emerald-400 font-bold">1,210</td>
              <td class="py-2.5 text-zinc-500">Free API Key</td>
            </tr>
            <tr>
              <td class="py-2.5 font-bold text-white">Groq Cloud</td>
              <td class="py-2.5 text-zinc-200 font-medium">14,400 Req / Day</td>
              <td class="py-2.5 text-emerald-400 font-bold">380 tps</td>
              <td class="py-2.5 text-emerald-400 font-bold">1,215</td>
              <td class="py-2.5 text-zinc-500">Free API Key</td>
            </tr>
            <tr>
              <td class="py-2.5 font-bold text-white">Pollinations AI</td>
              <td class="py-2.5 text-zinc-200 font-medium">Unlimited Anonymous</td>
              <td class="py-2.5">85 tps</td>
              <td class="py-2.5 text-emerald-400 font-bold">1,180</td>
              <td class="py-2.5 text-emerald-400">Zero Auth ($0)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DocsLayout>
