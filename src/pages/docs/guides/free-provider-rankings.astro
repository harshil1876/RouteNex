---
import DocsLayout from '../../../layouts/DocsLayout.astro';
---

<DocsLayout title="Free Provider Rankings" currentPath="/docs/guides/free-provider-rankings">
  <div class="space-y-8 font-mono text-xs">
    <div>
      <div class="text-[11px] text-purple-400 font-semibold mb-1">FREE TIER LEADERBOARD</div>
      <h1 class="text-2xl font-bold text-white font-sans">Free Provider Rankings (~1.62B Tokens/Mo)</h1>
      <p class="text-[#8f96a3] text-sm font-sans mt-1">Benchmarked leaderboard of free-tier providers by throughput and reliability.</p>
    </div>

    <div class="p-5 rounded-xl bg-[#121622] border border-[#222738] space-y-4">
      <div className="overflow-x-auto">
        <table className="w-full text-left text-xs">
          <thead className="border-b border-[#222738] text-[#8e97ae]">
            <tr>
              <th className="py-2">Provider</th>
              <th className="py-2">Free Allowance</th>
              <th className="py-2">Speed (tok/s)</th>
              <th className="py-2">Arena ELO</th>
              <th className="py-2">Auth Required</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-[#1b2234]">
            <tr>
              <td className="py-2.5 font-bold text-white">Mistral AI</td>
              <td className="py-2.5 text-purple-300">1 Billion / Month</td>
              <td className="py-2.5">140 tps</td>
              <td className="py-2.5 text-emerald-400 font-bold">1,248</td>
              <td className="py-2.5 text-[#7d8597]">Free API Key</td>
            </tr>
            <tr>
              <td className="py-2.5 font-bold text-white">Cerebras CS-3</td>
              <td className="py-2.5 text-purple-300">1 Million / Day (30M/mo)</td>
              <td className="py-2.5 text-emerald-400 font-bold">2,100 tps</td>
              <td className="py-2.5 text-emerald-400 font-bold">1,210</td>
              <td className="py-2.5 text-[#7d8597]">Free API Key</td>
            </tr>
            <tr>
              <td className="py-2.5 font-bold text-white">Groq Cloud</td>
              <td className="py-2.5 text-purple-300">14,400 Req / Day</td>
              <td className="py-2.5 text-emerald-400 font-bold">380 tps</td>
              <td className="py-2.5 text-emerald-400 font-bold">1,215</td>
              <td className="py-2.5 text-[#7d8597]">Free API Key</td>
            </tr>
            <tr>
              <td className="py-2.5 font-bold text-white">Pollinations AI</td>
              <td className="py-2.5 text-purple-300">Unlimited Anonymous</td>
              <td className="py-2.5">85 tps</td>
              <td className="py-2.5 text-emerald-400 font-bold">1,180</td>
              <td className="py-2.5 text-emerald-400">Zero Auth ($0)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DocsLayout>
