---
import DocsLayout from '../../../layouts/DocsLayout.astro';
---

<DocsLayout title="Auto-Combo & 19 Routing Strategies" currentPath="/docs/guides/auto-combo">
  <div class="space-y-8 font-mono text-xs">
    <div>
      <div class="text-[11px] text-zinc-400 font-semibold mb-1">ROUTING ENGINE</div>
      <h1 class="text-2xl font-bold text-white font-sans">Auto-Combo & 19 Routing Strategies</h1>
      <p class="text-zinc-400 text-sm font-sans mt-1">Deterministic selection, circuit breaker states, and fallback chains.</p>
    </div>

    <div class="p-5 rounded-xl bg-[#111113] border border-[#222226] space-y-4">
      <h2 class="text-sm font-bold text-white font-sans">Core Supported Strategies</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
        <div class="p-3 rounded-lg bg-[#18181b] border border-[#27272a]">
          <span class="text-white font-bold block mb-1">balanced (Default)</span>
          <p class="text-zinc-400">60% cost weight + 40% latency benchmark score.</p>
        </div>
        <div class="p-3 rounded-lg bg-[#18181b] border border-[#27272a]">
          <span class="text-white font-bold block mb-1">lkgp (Last-Known-Good)</span>
          <p class="text-zinc-400">Sticky provider affinity until an unrecoverable failure occurs.</p>
        </div>
        <div class="p-3 rounded-lg bg-[#18181b] border border-[#27272a]">
          <span class="text-white font-bold block mb-1">headroom</span>
          <p class="text-zinc-400">Prefers the account/provider pool with the highest remaining RPM/daily quota.</p>
        </div>
        <div class="p-3 rounded-lg bg-[#18181b] border border-[#27272a]">
          <span class="text-white font-bold block mb-1">cache-optimized</span>
          <p class="text-zinc-400">Hashes prefix messages to route repeat prompt context to the same provider cache.</p>
        </div>
      </div>
    </div>
  </div>
</DocsLayout>
