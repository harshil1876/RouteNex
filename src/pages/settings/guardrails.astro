---
import SettingsLayout from '../../layouts/SettingsLayout.astro';
---

<SettingsLayout title="Guardrails & Privacy" currentPath="/settings/guardrails">
  <div class="space-y-6 font-sans">
    <div class="border-b border-[#222226] pb-4">
      <h1 class="text-xl font-bold text-zinc-100 tracking-tight">Guardrails & Privacy</h1>
      <p class="text-xs text-zinc-500 mt-1">Configure edge moderation, PII redaction, and strict compliance filters before requests hit upstream models.</p>
    </div>

    <div class="space-y-4 font-mono text-xs">
      <div class="p-4 rounded-xl bg-[#09090b] border border-[#222226] flex items-center justify-between">
        <div>
          <span class="text-zinc-200 font-semibold block font-sans text-xs">Automatic PII Redaction</span>
          <span class="text-zinc-500 text-[11px] font-sans">Redacts credit card numbers, SSNs, and email addresses at the edge prior to model dispatch.</span>
        </div>
        <input type="checkbox" checked class="rounded border-zinc-700 bg-zinc-900" />
      </div>

      <div class="p-4 rounded-xl bg-[#09090b] border border-[#222226] flex items-center justify-between">
        <div>
          <span class="text-zinc-200 font-semibold block font-sans text-xs">Prompt Injection Guard</span>
          <span class="text-zinc-500 text-[11px] font-sans">Scans input prompts against jailbreak and delimiter manipulation patterns.</span>
        </div>
        <input type="checkbox" checked class="rounded border-zinc-700 bg-zinc-900" />
      </div>

      <div class="p-4 rounded-xl bg-[#09090b] border border-[#222226] flex items-center justify-between">
        <div>
          <span class="text-zinc-200 font-semibold block font-sans text-xs">Zero Data Retention (ZDR) Enforcement</span>
          <span class="text-zinc-500 text-[11px] font-sans">Strictly rejects any fallback candidate that does not sign a legally binding zero-retention SLA.</span>
        </div>
        <input type="checkbox" checked class="rounded border-zinc-700 bg-zinc-900" />
      </div>
    </div>
  </div>
</SettingsLayout>
