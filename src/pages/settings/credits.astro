---
import SettingsLayout from '../../layouts/SettingsLayout.astro';
---

<SettingsLayout title="Credits & Billing" currentPath="/settings/credits">
  <div class="space-y-6 font-sans">
    <div class="border-b border-[#222226] pb-4">
      <h1 class="text-xl font-bold text-zinc-100 tracking-tight">Credits & Billing</h1>
      <p class="text-xs text-zinc-500 mt-1">Manage prepaid cloud inference balance, auto-topup thresholds, and your monthly BYOK free tier.</p>
    </div>

    {/* Balance & Meter Cards */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-xl bg-[#09090b] border border-[#222226] space-y-2">
        <span class="text-xs text-zinc-500 font-mono block">Available Cloud Balance</span>
        <div class="text-3xl font-bold text-zinc-100 font-mono">$0.00</div>
        <p class="text-[11px] text-zinc-500">Pay-as-you-go inference across 347 upstream providers.</p>
        <div class="pt-2">
          <button
            type="button"
            class="px-3 py-1.5 rounded-lg bg-zinc-100 text-zinc-950 font-semibold text-xs hover:bg-white transition"
          >
            + Add Balance
          </button>
        </div>
      </div>

      <div class="p-5 rounded-xl bg-[#09090b] border border-[#222226] space-y-2">
        <span class="text-xs text-zinc-500 font-mono block">Monthly Free BYOK Allowance</span>
        <div class="text-3xl font-bold text-emerald-400 font-mono">$0 / $25,000</div>
        <p class="text-[11px] text-zinc-500">You can route up to $25k/mo of your own provider keys with zero platform fee.</p>
        <div class="w-full bg-[#111113] h-2 rounded-full overflow-hidden border border-[#222226] mt-2">
          <div class="bg-emerald-400 h-full rounded-full" style="width: 0%"></div>
        </div>
      </div>
    </div>

    {/* Promo Code Form */}
    <div class="p-5 rounded-xl bg-[#09090b] border border-[#222226] space-y-3 font-mono text-xs">
      <h3 class="font-semibold text-zinc-200 font-sans text-sm">Redeem Coupon or Promo Code</h3>
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          type="text"
          placeholder="ENTER-PROMO-CODE"
          class="w-full sm:w-64 bg-[#111113] border border-[#222226] rounded px-3 py-2 text-xs text-zinc-100 placeholder-zinc-600 focus:outline-none uppercase"
        />
        <button
          type="button"
          class="px-4 py-2 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium text-xs transition"
        >
          Redeem
        </button>
      </div>
    </div>

    {/* Payment Methods */}
    <div class="p-5 rounded-xl bg-[#09090b] border border-[#222226] space-y-3 font-mono text-xs">
      <h3 class="font-semibold text-zinc-200 font-sans text-sm">Payment Methods</h3>
      <p class="text-zinc-500 font-sans text-xs">No active payment methods saved. Supports Stripe, ACH, and Crypto.</p>
      <button
        type="button"
        class="px-3 py-1.5 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-medium text-xs transition"
      >
        + Add Payment Method
      </button>
    </div>
  </div>
</SettingsLayout>
