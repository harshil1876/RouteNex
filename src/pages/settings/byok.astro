---
import SettingsLayout from '../../layouts/SettingsLayout.astro';
---

<SettingsLayout title="BYOK Vault" currentPath="/settings/byok">
  <div class="space-y-6 font-sans">
    <div class="border-b border-[#222226] pb-4">
      <h1 class="text-xl font-bold text-zinc-100 tracking-tight">Cloud BYOK Vault</h1>
      <p class="text-xs text-zinc-500 mt-1">Bring your own upstream API keys. RouteNex Cloud will route traffic through your own credentials with zero markup.</p>
    </div>

    <div class="space-y-4 font-mono text-xs">
      {[
        { id: 'openai', name: 'OpenAI API Key', placeholder: 'sk-proj-...', hasKey: false },
        { id: 'anthropic', name: 'Anthropic API Key', placeholder: 'sk-ant-...', hasKey: false },
        { id: 'gemini', name: 'Google Gemini API Key', placeholder: 'AIzaSy...', hasKey: false },
        { id: 'groq', name: 'Groq Cloud API Key', placeholder: 'gsk_...', hasKey: false },
        { id: 'cerebras', name: 'Cerebras Cloud Key', placeholder: 'csk-...', hasKey: false },
        { id: 'nvidia', name: 'NVIDIA NIM API Key', placeholder: 'nvapi-...', hasKey: false },
      ].map((p) => (
        <div key={p.id} class="p-4 rounded-xl bg-[#09090b] border border-[#222226] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <span class="text-zinc-200 font-semibold block font-sans text-xs">{p.name}</span>
            <span class="text-zinc-500 text-[11px] font-sans">Encrypted at rest with cloud KMS.</span>
          </div>
          <div class="flex items-center gap-2">
            <input
              type="password"
              placeholder={p.placeholder}
              class="w-full sm:w-60 bg-[#111113] border border-[#222226] rounded px-3 py-1.5 text-xs text-zinc-100 placeholder-zinc-600 focus:outline-none"
            />
            <button
              type="button"
              class="px-3 py-1.5 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-sans transition shrink-0"
            >
              Save Key
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</SettingsLayout>
