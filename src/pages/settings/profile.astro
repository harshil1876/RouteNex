---
import SettingsLayout from '../../layouts/SettingsLayout.astro';
---

<SettingsLayout title="User Profile" currentPath="/settings/profile">
  <div class="space-y-6 font-sans">
    <div class="border-b border-[#222226] pb-4">
      <h1 class="text-xl font-bold text-zinc-100 tracking-tight">User Profile</h1>
      <p class="text-xs text-zinc-500 mt-1">Manage your Supabase authenticated credentials, name, and OAuth links.</p>
    </div>

    <div class="space-y-4">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center text-lg font-bold text-zinc-200">
          H
        </div>
        <div>
          <span class="text-sm font-semibold text-zinc-100 block">Harshil Patel</span>
          <span class="text-xs text-zinc-500 font-mono">harshil@routenex.com</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div>
          <label class="block text-xs font-mono text-zinc-400 mb-1">Full Name</label>
          <input
            type="text"
            value="Harshil Patel"
            class="w-full bg-[#09090b] border border-[#222226] rounded-lg px-3 py-2 text-xs text-zinc-100 focus:outline-none focus:border-zinc-500 font-sans"
          />
        </div>
        <div>
          <label class="block text-xs font-mono text-zinc-400 mb-1">Email Address</label>
          <input
            type="email"
            value="harshil@routenex.com"
            disabled
            class="w-full bg-[#09090b] border border-[#222226] rounded-lg px-3 py-2 text-xs text-zinc-500 font-sans opacity-70 cursor-not-allowed"
          />
        </div>
      </div>

      <div class="pt-4 border-t border-[#222226] space-y-2">
        <h3 class="text-xs font-bold text-zinc-200 font-mono uppercase">Connected Identities</h3>
        <div class="p-3 rounded-lg bg-[#09090b] border border-[#222226] flex items-center justify-between text-xs font-mono">
          <div class="flex items-center gap-2">
            <span>🐙</span>
            <span class="text-zinc-200">GitHub (OAuth 2.0)</span>
          </div>
          <span class="text-emerald-400 font-semibold">Connected</span>
        </div>
      </div>

      <div class="pt-2 flex justify-end">
        <button
          type="button"
          class="px-4 py-2 rounded-lg bg-zinc-100 text-zinc-950 font-semibold text-xs hover:bg-white transition"
        >
          Save Changes
        </button>
      </div>
    </div>
  </div>
</SettingsLayout>
