---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ModelCatalogExplorer from '../components/models/ModelCatalogExplorer';
---

<Layout title="AI Model Catalog (1,400+ Models) — RouteNex">
  <Header />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 space-y-8 font-sans">
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-zinc-800 border border-zinc-700 text-zinc-300 text-xs font-mono">
        <span>⚡ 347 Providers · 1,400+ Standardized Endpoints</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ink font-sans">
        Models Explorer & Performance Benchmarks
      </h1>
      <p class="text-body text-sm max-w-2xl">
        Explore live latency benchmarks, context windows, zero-cost free-tier quotas, and provider hosting options. Call any model through RouteNex with deterministic fallback.
      </p>
    </div>

    <!-- Interactive Model Explorer with Left Filter Rail & Modality Tabs (Screenshot 613) -->
    <ModelCatalogExplorer client:load />
  </main>

  <Footer />
</Layout>
