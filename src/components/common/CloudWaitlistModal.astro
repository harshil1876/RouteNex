---
// CloudWaitlistModal.astro
---

<div
  id="cloud-waitlist-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4 transition-all"
  role="dialog"
  aria-modal="true"
  aria-labelledby="waitlist-title"
>
  <div class="relative w-full max-w-md rounded-2xl bg-[#111113] border border-[#222226] p-6 sm:p-7 shadow-2xl text-left font-sans">
    {/* Close button */}
    <button
      id="close-waitlist-modal"
      type="button"
      class="absolute top-4 right-4 p-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition"
      aria-label="Close modal"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="flex items-center gap-3 mb-4">
      <img src="/logo.png" alt="RouteNex" width="32" height="32" class="h-8 w-8 rounded-lg object-contain shadow-sm" />
      <div>
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-white tracking-tight">RouteNex Cloud</span>
          <span class="rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-400 px-2 py-0.5 text-[10px] font-medium">
            Private Beta
          </span>
        </div>
        <p class="text-[11px] text-zinc-400 font-normal">Managed Edge Infrastructure for AI Teams</p>
      </div>
    </div>

    <h2 id="waitlist-title" class="text-lg font-bold text-white tracking-tight">
      Get Early Access to RouteNex Cloud
    </h2>
    <p class="text-xs text-zinc-400 mt-1.5 leading-relaxed">
      We are rolling out Cloud in batches to engineering teams after our open-source developer preview. Get managed edge failover tunnels, team RBAC, and centralized token spend auditing.
    </p>

    {/* Form */}
    <form id="waitlist-form" class="mt-5 space-y-3">
      <div>
        <label for="waitlist-email" class="block text-xs font-medium text-zinc-300 mb-1">
          Work Email
        </label>
        <input
          type="email"
          id="waitlist-email"
          required
          placeholder="you@company.com"
          class="w-full rounded-lg bg-[#18181b] border border-[#27272a] px-3.5 py-2.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-sky-500 transition-colors"
        />
      </div>

      <div>
        <label for="waitlist-usecase" class="block text-xs font-medium text-zinc-300 mb-1">
          Primary Use Case (Optional)
        </label>
        <select
          id="waitlist-usecase"
          class="w-full rounded-lg bg-[#18181b] border border-[#27272a] px-3 py-2 text-xs text-zinc-300 focus:outline-none focus:border-sky-500 transition-colors"
        >
          <option value="coding-agents">Autonomous Coding Agents (Cursor, Claude Code, Cline)</option>
          <option value="production-app">Production LLM Application Failover</option>
          <option value="cost-reduction">Token Cost Reduction & LexiPack Compression</option>
          <option value="agency-multi-tenant">Agency Multi-Client Key Management</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div id="waitlist-success" class="hidden p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs leading-relaxed">
        You are on the priority waitlist! We will reach out as new cloud workspace slots open.
      </div>

      <button
        type="submit"
        id="btn-waitlist-submit"
        class="w-full py-2.5 rounded-lg bg-sky-500 hover:bg-sky-400 !text-zinc-950 font-semibold text-xs transition shadow-sm cursor-pointer"
      >
        Request Early Access →
      </button>

      <div class="pt-2 text-center">
        <a
          href="/docs/getting-started/quick-start"
          class="text-[11px] text-zinc-400 hover:text-white transition inline-flex items-center gap-1"
        >
          <span>Need it now? Run RouteNex Open Source locally</span>
          <span>→</span>
        </a>
      </div>
    </form>
  </div>
</div>

<script>
  function setupWaitlistModal() {
    const modal = document.getElementById('cloud-waitlist-modal');
    const closeBtn = document.getElementById('close-waitlist-modal');
    const form = document.getElementById('waitlist-form');
    const successMsg = document.getElementById('waitlist-success');
    const submitBtn = document.getElementById('btn-waitlist-submit');

    const openModal = () => {
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    };

    const closeModal = () => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    };

    // Attach to all waitlist trigger elements
    document.querySelectorAll('[data-waitlist-trigger]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('waitlist-email') as HTMLInputElement;
      const email = emailInput?.value?.trim();
      if (!email) return;

      // Save to localStorage
      try {
        const existing = JSON.parse(localStorage.getItem('routenex_waitlist_emails') || '[]');
        if (!existing.includes(email)) existing.push(email);
        localStorage.setItem('routenex_waitlist_emails', JSON.stringify(existing));
      } catch {}

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.classList.add('opacity-50');
      }
      successMsg?.classList.remove('hidden');
    });

    // Check hash on page load
    if (window.location.hash === '#waitlist') {
      openModal();
    }
  }

  // Run on initial load and after view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWaitlistModal);
  } else {
    setupWaitlistModal();
  }
</script>
