---
// HowItWorks.astro
---

<section id="how-it-works" class="py-20 sm:py-28 bg-canvas border-t border-hairline scroll-mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-mute">Architecture</span>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
        How It Works
      </h2>
      <p class="mt-4 text-base text-body">
        A lightweight proxy layer sits transparently between your client applications and upstream model providers.
      </p>
    </div>

    <!-- 3-Step Flow Diagram -->
    <div class="mt-14 relative">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
        
        <!-- Step 1: Client App -->
        <div class="relative rounded-lg border border-hairline bg-elevated p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ink text-xs font-mono font-medium text-white">1</span>
              <span class="rounded bg-canvas px-2 py-0.5 font-mono text-[11px] text-mute border border-hairline-soft">Client Side</span>
            </div>
            <h3 class="text-base font-semibold text-ink">Your Application</h3>
            <p class="mt-2 text-sm text-body leading-relaxed">
              Send requests to a single endpoint using any OpenAI SDK or standard HTTP client.
            </p>
          </div>
          <div class="mt-6 rounded border border-hairline-soft bg-canvas p-3 font-mono text-xs text-mute">
            <span class="text-blue-600 font-medium">baseURL</span>: <span class="text-ink">http://localhost:3001/v1</span>
          </div>
        </div>

        <!-- Step 2: RouteNex Router -->
        <div class="relative rounded-lg border border-ink/20 bg-elevated p-6 shadow-xs flex flex-col justify-between ring-1 ring-ink/5">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ink text-xs font-mono font-medium text-white">2</span>
              <span class="rounded bg-blue-50 text-blue-700 px-2 py-0.5 font-mono text-[11px] font-medium border border-blue-200">Gateway Engine</span>
            </div>
            <h3 class="text-base font-semibold text-ink">RouteNex Router</h3>
            <p class="mt-2 text-sm text-body leading-relaxed">
              Validates authentication, checks circuit breakers, executes deterministic routing rules, and manages fallback cascades.
            </p>
          </div>
          <div class="mt-6 space-y-1.5 rounded border border-hairline-soft bg-canvas p-3 font-mono text-[11px] text-body">
            <div class="flex items-center justify-between">
              <span>Circuit State:</span>
              <span class="text-emerald-600 font-semibold">CLOSED (Healthy)</span>
            </div>
            <div class="flex items-center justify-between">
              <span>Failover Strategy:</span>
              <span class="text-ink">Bounded Retry [0ms, 150ms]</span>
            </div>
          </div>
        </div>

        <!-- Step 3: Upstream Providers -->
        <div class="relative rounded-lg border border-hairline bg-elevated p-6 shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ink text-xs font-mono font-medium text-white">3</span>
              <span class="rounded bg-canvas px-2 py-0.5 font-mono text-[11px] text-mute border border-hairline-soft">Upstream</span>
            </div>
            <h3 class="text-base font-semibold text-ink">AI Providers</h3>
            <p class="mt-2 text-sm text-body leading-relaxed">
              Groq, OpenAI, Gemini, Ollama — requests reach the fastest, cheapest, or most capable model with zero code changes.
            </p>
          </div>
          <div class="mt-6 flex flex-wrap gap-1.5 font-mono text-[11px]">
            <span class="rounded border border-hairline bg-canvas px-2 py-1 text-ink">Groq Llama-3</span>
            <span class="rounded border border-hairline bg-canvas px-2 py-1 text-ink">OpenAI GPT-4o</span>
            <span class="rounded border border-hairline bg-canvas px-2 py-1 text-ink">Gemini 1.5</span>
            <span class="rounded border border-hairline bg-canvas px-2 py-1 text-mute">Ollama Local</span>
          </div>
        </div>
      </div>

      <!-- Connecting arrows info bar -->
      <div class="mt-8 rounded-lg border border-hairline bg-canvas-elevated p-4 text-center">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 text-xs text-body font-mono">
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Primary Path: Sub-5ms Gateway Overhead
          </span>
          <span class="hidden sm:inline text-hairline">|</span>
          <span class="flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-amber-500"></span> Auto-Fallback: Zero Dropped Client Calls
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
