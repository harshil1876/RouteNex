---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-hairline bg-elevated/85 backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Left: Brand / Logo -->
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5 text-ink font-semibold tracking-tight transition hover:opacity-90" aria-label="RouteNex Home">
        <img src="/logo.png" alt="RouteNex" width="28" height="28" class="h-7 w-7 rounded-lg object-contain" />
        <span class="text-base font-semibold tracking-tight text-ink font-sans">RouteNex</span>
      </a>

      <!-- Desktop Nav links -->
      <nav class="hidden md:flex items-center gap-6" aria-label="Main Navigation">
        <a href="/models" class="text-sm font-normal text-body transition hover:text-ink">Models</a>
        <a href="/rankings" class="text-sm font-normal text-body transition hover:text-ink">Rankings</a>
        <a href="/pricing" class="text-sm font-normal text-body transition hover:text-ink">Pricing</a>
        <a href="/docs" class="text-sm font-normal text-body transition hover:text-ink">Docs</a>
        <a href="/dashboard" class="text-sm font-normal text-body transition hover:text-ink">Local Gateway</a>
      </nav>
    </div>

    <!-- Right: External actions & CTAs -->
    <div class="hidden sm:flex items-center gap-3">
      <ThemeToggle />

      <a
        href="https://github.com/harshil1876/RouteNex"
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-body transition hover:bg-hairline hover:text-ink"
        aria-label="GitHub Repository"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <button
        type="button"
        data-waitlist-trigger
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-hairline bg-canvas hover:bg-hairline/60 text-xs font-medium text-body hover:text-ink transition cursor-pointer"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
        <span>RouteNex Cloud (Join Waitlist)</span>
      </button>

      <a
        href="/docs/getting-started/quick-start"
        class="inline-flex items-center justify-center rounded-lg bg-sky-500 hover:bg-sky-400 !text-zinc-950 font-semibold px-4 py-2 text-xs sm:text-sm transition shadow-xs focus:outline-none"
      >
        Get Started — Open Source
      </a>
    </div>

    <!-- Mobile Hamburger Toggle via details disclosure -->
    <div class="flex items-center gap-2 sm:hidden">
      <ThemeToggle />
      <button
        type="button"
        data-waitlist-trigger
        class="text-xs font-medium text-body hover:text-ink px-2 py-1 transition cursor-pointer"
      >
        Cloud Waitlist
      </button>
      <a
        href="/docs/getting-started/quick-start"
        class="rounded-lg bg-sky-500 !text-zinc-950 px-3 py-1.5 text-xs font-semibold shadow-xs"
      >
        Open Source
      </a>
      <details class="relative">
        <summary class="flex h-9 w-9 list-none items-center justify-center rounded-md border border-hairline text-ink cursor-pointer hover:bg-hairline/60" aria-label="Toggle navigation menu">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <div class="absolute right-0 top-12 z-50 w-56 rounded-lg border border-hairline bg-elevated p-2 shadow-lg">
          <nav class="flex flex-col gap-1 text-sm">
            <a href="/models" class="rounded px-3 py-2 text-body hover:bg-hairline hover:text-ink">Model Catalog</a>
            <a href="/rankings" class="rounded px-3 py-2 text-body hover:bg-hairline hover:text-ink">Free Rankings</a>
            <a href="/pricing" class="rounded px-3 py-2 text-body hover:bg-hairline hover:text-ink">Pricing & Editions</a>
            <a href="/docs" class="rounded px-3 py-2 text-body hover:bg-hairline hover:text-ink">Documentation</a>
            <a href="/dashboard" class="rounded px-3 py-2 text-body hover:bg-hairline hover:text-ink">Local Console</a>
            <div class="my-1 border-t border-hairline"></div>
            <button
              type="button"
              data-waitlist-trigger
              class="w-full text-left rounded px-3 py-2 text-sky-500 hover:bg-hairline font-medium"
            >
              RouteNex Cloud (Join Waitlist)
            </button>
            <a href="https://github.com/harshil1876/RouteNex" target="_blank" rel="noreferrer" class="rounded px-3 py-2 text-body hover:bg-hairline hover:text-ink">GitHub</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
