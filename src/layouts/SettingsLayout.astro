---
import Layout from './Layout.astro';

interface Props {
  title: string;
  currentPath: string;
}

const { title, currentPath } = Astro.props;

const settingsNav = [
  { href: '/settings/profile', label: 'User Profile', id: 'profile' },
  { href: '/settings/preferences', label: 'Preferences', id: 'preferences' },
  { href: '/settings/credits', label: 'Credits & Billing', id: 'credits' },
  { href: '/settings/byok', label: 'BYOK Provider Vault', id: 'byok' },
  { href: '/settings/guardrails', label: 'Guardrails & Privacy', id: 'guardrails' },
];
---

<Layout title={`${title} — Settings — RouteNex Cloud`}>
  <div class="min-h-screen bg-[#09090b] text-zinc-300 font-sans flex flex-col">
    {/* Top Header */}
    <header class="h-14 border-b border-[#222226] bg-[#09090b]/90 backdrop-blur-md px-4 sm:px-6 flex items-center justify-between shrink-0 sticky top-0 z-40">
      <div class="flex items-center gap-3">
        <a href="/workspace" class="flex items-center gap-2 text-xs font-sans text-zinc-400 hover:text-white transition">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Back to Workspace</span>
        </a>
        <span class="text-zinc-600">/</span>
        <span class="text-xs font-sans font-semibold text-zinc-100">Account Settings</span>
      </div>

      <div class="flex items-center gap-3">
        <a href="/workspace" class="px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-sans transition">
          Console
        </a>
      </div>
    </header>

    {/* Body */}
    <div class="flex-1 max-w-6xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      {/* Left Settings Sidebar */}
      <aside class="md:col-span-3 space-y-1 font-sans text-xs">
        <div class="px-2 py-1 text-[10px] text-zinc-500 uppercase tracking-wider font-semibold">
          Settings Menu
        </div>
        {settingsNav.map((item) => {
          const isActive = currentPath === item.href;
          return (
            <a
              href={item.href}
              class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition ${
                isActive
                  ? 'bg-sky-500/10 text-sky-400 font-semibold border border-sky-500/30'
                  : 'text-zinc-400 hover:text-zinc-100 hover:bg-zinc-900'
              }`}
            >
              {item.id === 'profile' && (
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              )}
              {item.id === 'preferences' && (
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
              )}
              {item.id === 'credits' && (
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                  <line x1="1" y1="10" x2="23" y2="10"></line>
                </svg>
              )}
              {item.id === 'byok' && (
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                </svg>
              )}
              {item.id === 'guardrails' && (
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              )}
              <span>{item.label}</span>
            </a>
          );
        })}
        <div class="pt-3 border-t border-[#222226]">
          <a href="/login" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-rose-400 hover:bg-zinc-900 transition">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Sign Out</span>
          </a>
        </div>
      </aside>

      {/* Main Settings Card */}
      <main class="md:col-span-9 p-6 rounded-2xl bg-[#111113] border border-[#222226] shadow-sm space-y-6">
        <slot />
      </main>
    </div>
  </div>
</Layout>
