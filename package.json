{
  "name": "routenex",
  "type": "module",
  "version": "0.2.0",
  "description": "High-Performance Open-Source AI Gateway & Routing Proxy with Free-Tier Pools and Coding Agent Integrations",
  "license": "MIT OR Apache-2.0",
  "author": "Harshil Patel",
  "homepage": "https://github.com/harshil1876/RouteNex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshil1876/RouteNex.git"
  },
  "keywords": [
    "ai",
    "router",
    "gateway",
    "proxy",
    "llm",
    "openai",
    "groq",
    "anthropic",
    "mistral",
    "gemini",
    "deepseek",
    "cursor",
    "claude-code",
    "cline"
  ],
  "files": [
    "bin",
    "dist",
    "gateway/dist",
    "package.json",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE"
  ],
  "bin": {
    "routenex": "bin/routenex.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node ./bin/routenex.js",
    "start:oss": "node ./bin/routenex.js",
    "dev:oss": "node ./bin/routenex.js",
    "dev": "astro dev",
    "dev:web": "astro dev",
    "dev:api": "npm --prefix gateway run dev",
    "build:api": "npm --prefix gateway run build",
    "build:docs": "astro build",
    "test:api": "npm --prefix gateway test",
    "doctor": "npm --prefix gateway run doctor",
    "test:live": "npm --prefix gateway run test:live",
    "build": "astro build && npm --prefix gateway run build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
